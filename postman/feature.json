{
  "info": {
    "name": "ExploreWithMe - Comments feature",
    "description": "Postman-коллекция для проверки функциональности комментариев к событиям.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "1" },
    { "key": "userId2", "value": "2" },
    { "key": "eventId", "value": "1" },
    { "key": "commentId", "value": "1" }
  ],
  "item": [
    {
      "name": "01. Setup: create users",
      "item": [
        {
          "name": "Create user 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('userId', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"commenter1@example.com\",\"name\":\"Commenter One\"}"
            },
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Create user 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('userId2', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"commenter2@example.com\",\"name\":\"Commenter Two\"}"
            },
            "url": "{{baseUrl}}/admin/users"
          }
        }
      ]
    },
    {
      "name": "02. Setup: create category and event",
      "item": [
        {
          "name": "Create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Comments Category\"}"
            },
            "url": "{{baseUrl}}/admin/categories"
          }
        },
        {
          "name": "Create event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('eventId', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"annotation\":\"Event for comments testing, come all\",\"category\":1,\"description\":\"Description of the event used for testing comments\",\"eventDate\":\"2027-12-31 20:00:00\",\"location\":{\"lat\":55.75,\"lon\":37.62},\"title\":\"Comments Test Event\"}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/events"
          }
        },
        {
          "name": "Publish event (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('event is published', () => {",
                  "  pm.expect(pm.response.json().state).to.eql('PUBLISHED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"stateAction\":\"PUBLISH_EVENT\"}"
            },
            "url": "{{baseUrl}}/admin/events/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "03. Comments: create",
      "item": [
        {
          "name": "Create comment - valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('has id', () => pm.response.json().id !== undefined);",
                  "pm.test('has text', () => pm.expect(pm.response.json().text).to.eql('Great event!'));",
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('commentId', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"text\":\"Great event!\"}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/comments?eventId={{eventId}}"
          }
        },
        {
          "name": "Create comment - empty text -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"text\":\"\"}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/comments?eventId={{eventId}}"
          }
        },
        {
          "name": "Create comment - unknown user -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"text\":\"Some text\"}"
            },
            "url": "{{baseUrl}}/users/999999/comments?eventId={{eventId}}"
          }
        },
        {
          "name": "Create comment - unknown event -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"text\":\"Some text\"}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/comments?eventId=999999"
          }
        }
      ]
    },
    {
      "name": "04. Comments: read",
      "item": [
        {
          "name": "Get event comments - valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('has at least one comment', () => pm.expect(pm.response.json().length).to.be.at.least(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/{{eventId}}/comments?from=0&size=10"
          }
        },
        {
          "name": "Get event comments - unknown event -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/999999/comments"
          }
        }
      ]
    },
    {
      "name": "05. Comments: delete by author",
      "item": [
        {
          "name": "Delete comment by wrong user -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId2}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Delete comment by author -> 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Delete already deleted comment -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "06. Comments: delete by admin",
      "item": [
        {
          "name": "Create another comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('commentId', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"text\":\"Comment for admin moderation\"}"
            },
            "url": "{{baseUrl}}/users/{{userId}}/comments?eventId={{eventId}}"
          }
        },
        {
          "name": "Delete comment by admin -> 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/comments/{{commentId}}"
          }
        },
        {
          "name": "Delete unknown comment by admin -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/comments/999999"
          }
        }
      ]
    }
  ]
}